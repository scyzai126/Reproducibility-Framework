{
  "claim_1": {
    "claim": "Bulk RNA-seq analysis of platelet-rich plasma from 65 individuals across young, older community-dwelling, and older SNF-resident adults at Day 0, Day 2, Day 7, and Day 28 post-vaccination showed age-associated increases in platelet activation RNAs and mitochondrial genes, with decreases in translation-related RNAs.",
    "sources": [
      {
        "type": "text",
        "section": "Results",
        "quote": "We isolated platelet-rich plasma (PRP) from blood samples of participants obtained prior to vaccination (Day 0) and at Days 2, 7, and 28 post-vaccine for isolation of RNA and elucidation of the platelet transcriptome via RNA-seq."
      },
      {
        "type": "text",
        "section": "Results",
        "quote": "Taken together, these findings indicate an age-associated increase in expression of platelet activation RNAs and mitochondrial genes and a decrease in expression of RNAs encoding translation-related proteins."
      },
      {
        "type": "text",
        "section": "Methods",
        "quote": "We enrolled 28 young adults (age 21\u201335\u2009years), 20 community-dwelling older adults (age \u226565\u2009years) (Older (Comm)), and 17 older adults (age \u226565\u2009years) (Older (SNF)) who were residents of a skilled nursing facility (SNF) in greater New Haven, Connecticut."
      }
    ],
    "comparison_strategy": "cross_sectional_longitudinal",
