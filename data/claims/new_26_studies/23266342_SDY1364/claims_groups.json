  "claim_4": {
    "claim": "ELISA analysis of serum from 12 intramuscular and 12 intradermal vaccinees at weeks 0, 2, 4 and 24 showed intradermal MVA85A significantly increased anti-85A IgG at week 4 and week 24 compared to baseline and week 2, whereas the intramuscular group showed no significant increase and there were no significant differences between groups at any time-point.",
    "sources": [
      {
        "type": "text",
        "section": "Results",
        "quote": "Volunteers who were vaccinated intradermally with MVA85A had significantly higher serum IgG 4 weeks post-vaccination when compared to baseline (p = 0.0342) and week-2 (p = 0.0005). There was no significant increase during follow-up in IgG levels in the intramuscularly immunised group, similarly no significant differences were observed between the two groups at any of the time points."
      },
      {
        "type": "text",
        "section": "Methods",
        "quote": "Anti-r85A IgG was measured in serum samples collected at week 0, 2, 4 and 24."
      },
      {
        "type": "figure",
        "ref": "Figure 5"
      }
    ],
