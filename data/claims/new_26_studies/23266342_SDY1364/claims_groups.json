  "claim_2": {
    "claim": "Flow Cytometry analysis of cryopreserved PBMC from vaccinated subjects at weeks 0, 1 and 24 showed both intradermal and intramuscular MVA85A induced significant PPD- and 85A-specific CD4+ T-cell production of IFNγ, TNFα and IL2, including polyfunctional CD4+ T cells, compared to baseline, with no significant differences between vaccination routes at any time-point.",
    "sources": [
      {
        "type": "text",
        "section": "Results",
        "quote": "Mycobacteria-specific cytokines (IFNγ, TNFα and IL2) were measured in subjects’ cryopreserved PBMC after overnight stimulation with PPD and a single pool of 85A peptides (Fig. 4). Both routes of vaccination induced significant IFNγ, TNFα and IL2 at weeks 1 and 24 post vaccination. Levels of produced cytokines between the two groups did not significantly differ at any time-point."
      },
      {
        "type": "figure",
        "ref": "Figure 4"
      },
      {
        "type": "figure",
        "ref": "Figure 4C"
      }
    ],
