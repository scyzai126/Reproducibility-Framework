DROP TABLE IF EXISTS file_details;

CREATE TABLE file_details
(
  
  file_details_id INT NOT NULL
    COMMENT "Primary key",

  reported_md5 VARCHAR(32)
    COMMENT "md5 value reported by submitter",
  
  generated_md5 VARCHAR(32)
    COMMENT "md5 value generated by ImmPort",
  
  study_accession VARCHAR(15)
    COMMENT "Reference to the STUDY table",

  filesize_bytes BIGINT
    COMMENT "File size in bytes",
  
  file_type VARCHAR(250) NOT NULL
    COMMENT "Type of file",

  file_accession VARCHAR(250) NOT NULL
    COMMENT "ImmPort file accession",

  file_name VARCHAR(250) NOT NULL
    COMMENT "Name of the file",

  path VARCHAR(4000)
    COMMENT "Path to the location of the file in the file directories",

  date_file_updated DATETIME
    COMMENT "The Date the file was last updated",

  ai_generated_keywords VARCHAR(4000)
    COMMENT "Study file Keywords generated by AI",

  ai_generated_summary VARCHAR(4000)
    COMMENT "Study file summary generated by AI",

  file_uuid VARCHAR(36)
    COMMENT "UUID generated by ImmPort",

  drs_object_created VARCHAR(1)
    COMMENT "Flag indicating DRS object was created",

  workspace_id INT NOT NULL
    COMMENT "Foreign key reference to WORKSPACE table",
  
  PRIMARY KEY (file_details_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8
  COMMENT "Contains metadata and content for files, template files, and other files archived to workspaces.";

CREATE INDEX idx_file_details_workspace on file_details(workspace_id);
CREATE INDEX idx_file_details_study on file_details(study_accession);